{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/finalize-payroll.js": {
      "includeFiles": "templates/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://payroll-application-f6d25.firebaseapp.com/__/auth/:path*"
    }
  ]
}
