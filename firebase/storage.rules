rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.platformRole == "platform_admin";
    }

    function isCompanyMember(companyId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/companies/$(companyId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.status == "active";
    }

    match /companies/{companyId}/{allPaths=**} {
      allow read: if isCompanyMember(companyId) || isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }
  }
}
